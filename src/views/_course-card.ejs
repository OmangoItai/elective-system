<article id="card-<%= c.id %>" data-course-selected="<%= c.state === 'selected' ? 'true' : 'false' %>" class="bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow p-6 min-w-0 break-words">
  <div class="flex items-start justify-between gap-3 mb-3">
    <h3 class="text-lg font-semibold text-gray-900"><%= c.name %></h3>
    <% if (c.state === "selected") { %>
      <%- include('_components/badge', { text: '已选', variant: 'success' }) %>
    <% } else if (c.state === "full") { %>
      <%- include('_components/badge', { text: '已满', variant: 'danger' }) %>
    <% } else if (c.state === "closed") { %>
      <%- include('_components/badge', { text: '已截止', variant: 'warning' }) %>
    <% } else if (c.state === "waiting") { %>
      <%- include('_components/badge', { text: '等待开放', variant: 'info' }) %>
    <% } else { %>
      <%- include('_components/badge', { text: '可选', variant: 'success' }) %>
    <% } %>
  </div>

  <% if (c.tag) { %>
  <div class="mb-3">
    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-sm font-semibold bg-red-50 text-red-600 border border-red-200"><%= c.tag %></span>
  </div>
  <% } %>

  <div class="space-y-1.5 text-sm text-gray-500 mb-4">
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      <span><%= c.teacher %></span>
    </div>
    <% if (c.courseTime) { %>
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span><%= c.courseTime %></span>
    </div>
    <% } %>
    <% if (c.location) { %>
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      <span><%= c.location %></span>
    </div>
    <% } %>
    <% if (c.allowedGrades) { %>
    <div class="flex items-center gap-2">
      <span>允许年级：<%= String(c.allowedGrades).split(',').map(function(g) { return g + '级'; }).join('、') %></span>
    </div>
    <% } %>
    <% if (c.description) { %>
    <p class="course-description-preview text-xs text-gray-400 pt-1"><%= String(c.description).slice(0, 100) %></p>
    <% } %>
  </div>

  <% if (c.state !== "waiting") { %>
  <%
    var ratio = c.totalSeats > 0 ? c.availableSeats / c.totalSeats : 0;
    var barColor = ratio > 0.5 ? 'bg-green-500' : (ratio > 0.2 ? 'bg-yellow-500' : 'bg-red-500');
    var textColor = ratio > 0.5 ? 'text-green-700' : (ratio > 0.2 ? 'text-yellow-700' : 'text-red-700');
  %>
  <div class="mb-4">
    <div class="flex justify-between items-center text-xs mb-1">
      <span class="text-gray-500">名额</span>
      <span class="font-medium <%= textColor %>"><%= c.availableSeats %> / <%= c.totalSeats %></span>
    </div>
    <div class="w-full bg-gray-100 rounded-full h-2">
      <div class="<%= barColor %> h-2 rounded-full transition-all" style="width: <%= (1 - ratio) * 100 %>%"></div>
    </div>
  </div>
  <% } %>

  <div class="mt-auto">
    <% if (c.state === "selected") { %>
      <button id="drop-btn-<%= c.id %>"
              data-course-drop
              class="relative w-full text-sm font-medium rounded-lg px-4 py-2 bg-red-500 text-white hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors"
              hx-post="/api/courses/<%= c.id %>/drop"
              hx-target="#card-<%= c.id %>"
              hx-swap="outerHTML"
              hx-indicator="#drop-btn-<%= c.id %>">
        <svg class="htmx-indicator animate-spin absolute left-4 top-1/2 -translate-y-1/2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        退课
      </button>
      <% if (c.endtime) { %>
      <span class="countdown-end block mt-2 text-center text-xs text-gray-500" data-endtime="<%= c.endtime %>"></span>
      <% } %>
    <% } else if (c.state === "full") { %>
      <button disabled class="w-full inline-flex items-center justify-center text-sm font-medium rounded-lg px-4 py-2 bg-gray-100 text-gray-400 cursor-not-allowed">已满</button>
    <% } else if (c.state === "closed") { %>
      <button disabled class="w-full inline-flex items-center justify-center text-sm font-medium rounded-lg px-4 py-2 bg-gray-100 text-gray-400 cursor-not-allowed">已截止</button>
    <% } else if (c.state === "waiting") { %>
      <button disabled id="btn-<%= c.id %>" class="w-full inline-flex items-center justify-center text-sm font-medium rounded-lg px-4 py-2 bg-gray-100 text-gray-400 cursor-not-allowed" data-opentime="<%= c.opentime %>">
        --
      </button>
    <% } else { %>
      <button id="btn-<%= c.id %>"
              data-course-select
              class="relative w-full text-sm font-medium rounded-lg px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
              hx-post="/api/courses/<%= c.id %>/select"
              hx-target="#card-<%= c.id %>"
              hx-swap="outerHTML"
              hx-indicator="#btn-<%= c.id %>">
        <svg class="htmx-indicator animate-spin absolute left-4 top-1/2 -translate-y-1/2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        抢课
      </button>
      <% if (c.endtime) { %>
      <span class="countdown-end block mt-2 text-center text-xs text-gray-500" data-endtime="<%= c.endtime %>"></span>
      <% } %>
    <% } %>
  </div>
</article>
